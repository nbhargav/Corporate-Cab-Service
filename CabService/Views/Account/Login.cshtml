@{
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <title>Login - Corporate Cab Service</title>
    <style>
        body { font-family: Segoe UI, Arial, sans-serif; background: #1a2634; height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
        .card { background: white; padding: 40px; border-radius: 8px; width: 320px; }
        input { width: 100%; padding: 10px; margin: 8px 0; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background: #2d6cdf; color: white; border: none; border-radius: 4px; margin-top: 10px; }
        .error { color: #c0392b; font-size: 14px; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Sign in</h2>
        @if (!ViewData.ModelState.IsValid)
        {
            <p class="error">@ViewData.ModelState[""]?.Errors.FirstOrDefault()?.ErrorMessage</p>
        }
        <form method="post" asp-action="Login">
            @Html.AntiForgeryToken()
            <input type="text" name="username" placeholder="Username" required />
            <input type="password" name="password" placeholder="Password" required />
            <button type="submit">Login</button>
        </form>
        <p style="text-align:center; margin-top:15px;">
            <a asp-action="Register">Create an account</a>
        </p>
    </div>
</body>
</html>
